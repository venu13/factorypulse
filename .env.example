# Copy to .env and export (e.g. `set -a; source .env; set +a`). Contains NO secrets - never commit a real .env.

# --- Option A: Vertex AI (recommended; uses Application Default Credentials / the Cloud Run service account)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Gemini Developer API key (leave unset when using Vertex)
# GEMINI_API_KEY=

# --- Model and call behaviour
GEMINI_MODEL=gemini-2.5-flash
FACTORYPULSE_LLM_TIMEOUT_S=60

# --- Optional Google Cloud integrations (unset = fully offline / in-memory)
# FACTORYPULSE_GCS_BUCKET=your-project-factorypulse
# FACTORYPULSE_BQ_DATASET=factorypulse
# FACTORYPULSE_BQ_LOCATION=US

# --- Testing only: force the offline rule engine (never set this on Cloud Run)
# FACTORYPULSE_FORCE_MOCK=1
